# Repository text files always use Unix LF
* text=auto

*.py      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.service text eol=lf
*.lock    text eol=lf

# Binary and model files
*.rknn binary
*.onnx binary
*.pt   binary
*.npy  binary
*.wav  binary
*.mp3  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.gz   binary

*.mvn binary
