# Python environments and caches
venv/
.venv/
__pycache__/
*.py[cod]

# Secrets and machine-local configuration
config/.env
config/.env.*
!config/.env.*.example

# Runtime data
logs/
data/
*.log

# Large runtime models and local binary wheels
models/**/*.rknn
models/**/*.onnx
models/**/*.pt
vendor/wheels/*.whl
!models/**/README.md
!models/manifest.sha256

# Build and migration outputs
*.tar.gz
*.img
*.img.xz
board-inventory-*.txt
quarantine-*/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Machine-local migration state
MIGRATION_STATE.txt
requirements-installed.txt

# Exported RKNN runtime binary; shipped with image/release artifact
vendor/rknn-runtime-site/
