LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-private-key
LLM_MODEL=qwen-plus

AI_AGENT_TTS_BACKEND=edge
AI_AGENT_EDGE_VOICE=zh-CN-XiaoxiaoNeural
AI_AGENT_ALWAYS_LISTEN=1
AI_AGENT_BARGE_IN_ENABLED=1
AI_AGENT_UI_MODE=user
AI_AGENT_TTS_MODE=whole
AI_AGENT_STREAM_RESPONSE=1
AI_AGENT_MAX_RESPONSE_TOKENS=240
AI_AGENT_AUDIO_DEVICE=auto
AI_AGENT_MAX_AUDIO_FAILURES=3

SENSEVOICE_RKNN_MODEL=models/speech/sensevoice/sensevoice_time100_fp.rknn
SENSEVOICE_FRONTEND_CONFIG=models/speech/sensevoice/config.yaml
SENSEVOICE_CMVN=models/speech/sensevoice/am.mvn
SENSEVOICE_TOKENS=models/speech/sensevoice/tokens.json
PIPER_MODEL=models/speech/tts/zh_CN-huayan-medium.onnx
